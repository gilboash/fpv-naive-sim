build/
*.log

# screen(1) capture, not project content
/screenlog.0

# Collected usage summaries, if serve.py is ever run from the repo root.
# Anchored: an unanchored `data/` matches a directory of that name at any depth,
# which silently swallowed two different datasets in ../genius-invester.
/data/

# Reference-lap videos: generated by tools/replay-video.mjs, served on demand
# rather than bundled, and far too large to live in git.
/reference/

# NacoSim maps that are not ours to publish in the repo. The zip build picks them
# up from here when present, so a deployment built on this Mac still carries them.
/edgetx/maps-local/
